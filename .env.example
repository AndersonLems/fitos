# Chave da API Gemini (https://aistudio.google.com/apikey). Nunca versione este valor.
GEMINI_API_KEY=
# Modelo usado nas gerações. Os nomes mudam com o tempo; ajuste em Configurações se necessário.
GEMINI_MODEL=gemini-flash-latest
# Banco SQLite local
FITOS_DATABASE_URL=sqlite:///data/fitos.db
# Código de acesso exigido na abertura do app. Obrigatório quando o app é exposto
# por túnel (Cloudflare etc). Deixe vazio apenas para uso estritamente local.
FITOS_ACCESS_CODE=
